# Conexao SQL Server. Sem SQL_SERVER o servico usa repositorio em memoria.
SQL_SERVER=
SQL_PORT=1433
SQL_DATABASE=pjbl_mentoria
SQL_USER=sa
SQL_PASSWORD=
# Azure SQL Edge local aceita TLS com certificado proprio.
SQL_ENCRYPT=false

PORT=4002
# Destino do outbox (CloudEvents). O relay faz POST em ${EVENT_SINK_URL}/api/eventos.
EVENT_SINK_URL=http://azure-function:80
SEED_ON_START=true
CORS_ORIGIN=*
