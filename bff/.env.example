# Ambiente do BFF (copie para .env e ajuste se necessário)
NODE_ENV=development
PORT=4000

# Dependências internas (nomes dos serviços no docker-compose)
MENTORES_URL=http://mentores-service:4001
SESSOES_URL=http://sessoes-service:4002
FUNCTION_URL=http://azure-function:80

# Para rodar fora do compose, troque por http://localhost:4001, :4002 e :7071

CORS_ORIGIN=*
HTTP_TIMEOUT_MS=3000
HEALTH_TIMEOUT_MS=1000
