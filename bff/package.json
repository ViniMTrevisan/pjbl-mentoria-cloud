{
  "name": "pjbl-mentoria-bff",
  "version": "1.0.0",
  "private": true,
  "description": "BFF da arquitetura de microservices do PjBL Mentoria",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run && depcruise src",
    "test:watch": "vitest",
    "arch": "depcruise src"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "4.21.2",
    "swagger-ui-express": "5.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.7.5",
    "@types/swagger-ui-express": "4.1.6",
    "dependency-cruiser": "16.10.4",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
