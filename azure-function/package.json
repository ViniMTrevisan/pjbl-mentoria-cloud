{
  "name": "azure-function-reputacao",
  "version": "3.0.0",
  "private": true,
  "description": "Azure Function HTTP trigger de cálculo de reputação e sink de eventos do Veterano.",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "dev": "npm run build && func start",
    "build": "tsc -p tsconfig.json",
    "start": "func start",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@azure/functions": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "archunit": "^2.5.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
