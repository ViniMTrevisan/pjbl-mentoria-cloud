flowchart LR
    classDef entrada fill:#d9f24a,stroke:#16233a,color:#16233a
    classDef app fill:#eaf0ff,stroke:#5c6b8a,color:#16233a
    classDef dom fill:#fff1c7,stroke:#a58a2e,color:#16233a
    classDef porta fill:#f3e8ff,stroke:#8a5cc2,color:#16233a
    classDef infra fill:#e8f5e9,stroke:#3d7a45,color:#16233a

    subgraph HTTP["Entrada"]
        H1["<b>routes.ts</b><br/>/sessoes · PATCH status"]:::entrada
        H2["<b>Swagger</b><br/>/docs · /openapi.json"]:::entrada
    end

    subgraph Fatias["features/"]
        F1["createSessao"]:::app
        F2["listSessoes"]:::app
        F3["getSessao"]:::app
        F4["changeStatus"]:::app
    end

    subgraph Dominio["domain/"]
        D1["criarSessao (validação)"]:::dom
        D2["máquina de estados<br/>aceitar/recusar/cancelar/concluir"]:::dom
        D3["autorização por ator"]:::dom
    end

    subgraph Portas["ports/"]
        P1["SessaoRepository<br/>+ Outbox"]:::porta
        P2["EventPublisher"]:::porta
    end

    subgraph Infra["infrastructure/"]
        I1["SqlSessaoRepository<br/>transação + rowversion"]:::infra
        I2["OutboxRelay (2s)"]:::infra
        I3["InMemorySessaoRepository"]:::infra
    end

    DB[("<b>SQL Server 2022</b><br/>SESSAO · OUTBOX_EVENTO")]
    Function["<b>Azure Function</b><br/>POST /api/eventos"]

    H1 --> F1 & F2 & F3 & F4
    F1 --> D1 --> P1
    F4 --> D2 --> D3 --> P1
    P1 -.-> I1
    P1 -.-> I3
    I1 --> DB
    I2 --> P2
    P2 --> Function
    DB --> I2
