    classDef ev fill:#d9f24a,stroke:#16233a,color:#16233a
    classDef sink fill:#e8f5e9,stroke:#3d7a45,color:#16233a
    classDef target fill:#f6f8fb,stroke:#9aa7bd,color:#16233a

    subgraph Local["Implementação local (demo)"]
