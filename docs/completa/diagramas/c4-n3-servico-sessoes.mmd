---
config:
  layout: elk
  elk:
    nodePlacementStrategy: BRANDES_KOEPF
---
flowchart TB
    classDef comp fill:#85bbf0,stroke:#5d82a8,color:#0b2340
    classDef cont fill:#438dd5,stroke:#2e6295,color:#ffffff

    BFF["<b>BFF Web</b><br/>[Container]"]:::cont

    subgraph S["Serviço de Sessões [Container: Azure Functions v4, Node 22]"]
        direction LR
        subgraph E["Entrada"]
            direction TB
            H["<b>Triggers HTTP</b><br/>[Component]<br/>POST /sessoes<br/>PATCH /sessoes/{id}/status<br/>GET /sessoes"]:::comp
            T["<b>Relay do outbox</b><br/>[Component: Timer trigger, 10 s]"]:::comp
        end
        subgraph A["Fatias"]
            direction TB
            F1["<b>solicitarSessao</b><br/>[Component]"]:::comp
            F2["<b>responderSessao</b><br/>[Component] aceitar / recusar"]:::comp
            F3["<b>encerrarSessao</b><br/>[Component] concluir / cancelar"]:::comp
            F4["<b>listarSessoes</b><br/>[Component]"]:::comp
        end
        subgraph D["Domínio e portas"]
            direction TB
            M["<b>Sessao</b><br/>[Component: máquina de estados<br/>+ autorização por papel]"]:::comp
            P1["<b>SessaoRepository</b><br/>[Component: porta]"]:::comp
            P2["<b>DisponibilidadeGateway</b><br/>[Component: porta]"]:::comp
        end
        subgraph I["Adaptadores"]
            direction TB
            R["<b>SqlSessaoRepository</b><br/>[Component: mssql]<br/>grava sessão + outbox<br/>na mesma transação"]:::comp
            G["<b>MentoresHttpClient</b><br/>[Component: fetch]"]:::comp
            Pub["<b>ServiceBusPublisher</b><br/>[Component: @azure/service-bus]"]:::comp
        end
    end

    DB[("<b>BD Sessões</b><br/>[Container: Azure SQL]<br/>SESSAO, OUTBOX")]:::cont
    SM["<b>Serviço de Mentores</b><br/>[Container]"]:::cont
    Bus[["<b>Barramento de Eventos</b><br/>[Container: Service Bus]"]]:::cont

    BFF -->|"JSON/HTTPS"| H
    H --> F1 & F2 & F3 & F4
    F1 & F2 & F3 --> M
    F1 & F2 & F3 & F4 --> P1
    F1 --> P2
    R -.->|"implementa"| P1
    G -.->|"implementa"| P2
    R --> DB
    G -->|"GET disponibilidade"| SM
    T --> R
    T --> Pub
    Pub -->|"SessaoSolicitada, SessaoAceita, ..."| Bus

    style S fill:#ffffff,stroke:#444444,stroke-dasharray:6 4,color:#444444
    style E fill:#f6f8fb,stroke:#9aa7bd
    style A fill:#f6f8fb,stroke:#9aa7bd
    style D fill:#fdf8e6,stroke:#c9a94a
    style I fill:#f6f8fb,stroke:#9aa7bd
