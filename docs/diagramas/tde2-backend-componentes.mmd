flowchart LR
  subgraph Entrada[Adaptador de entrada]
    HTTP[Azure Functions<br/>rotas HTTP]
    COMPOSICAO[functions/dependencies.js<br/>composicao e injecao]
  end

  subgraph Aplicacao[Aplicacao - Vertical Slices]
    MENTORES[Fatias de mentores<br/>listar, obter, criar,<br/>pesquisar, alterar, excluir]
    SESSOES[Fatia de sessoes<br/>listar e classificar]
  end

  subgraph Dominio[Dominio]
    REGRAS[mentor.js<br/>validacao, reputacao,<br/>normalizacao]
    PORTA[MentorRepository<br/>contrato JSDoc]
  end

  subgraph Adaptadores[Adaptadores de saida]
    MOCK[MockMentorCatalog<br/>catalogo de leitura]
    DADOS[data/mock.js<br/>fixtures]
    MONGO[MongoMentorRepository<br/>CRUD e mapeamento]
    CLIENT[mongo/client.js<br/>conexao lazy e pool]
  end

  HTTP --> MENTORES
  HTTP --> SESSOES
  COMPOSICAO -. injeta .-> MONGO
  COMPOSICAO -. injeta .-> MOCK
  MENTORES --> REGRAS
  MENTORES --> PORTA
  MENTORES --> MOCK
  SESSOES --> MOCK
  MONGO -. implementa .-> PORTA
  MOCK --> DADOS
  MONGO --> CLIENT
  CLIENT --> DB[(MongoDB Atlas<br/>pjbl_mentoria.mentores)]

