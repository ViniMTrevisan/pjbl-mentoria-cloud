  classDef adaptador fill:#eef1f6,stroke:#5c6b8a,color:#16233a;
  class HTTP,COMPOSICAO entrada;
  class MENTORES,SESSOES aplicacao;
  class REGRAS,PORTA dominio;
  class MOCK,DADOS,MONGO,CLIENT,DB adaptador;
